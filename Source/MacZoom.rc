#include <winresrc.h>

#include "Version.h"

1 VERSIONINFO
FILEVERSION MACZOOM_VERSION_MAJOR, MACZOOM_VERSION_MINOR, MACZOOM_VERSION_PATCH, 0
PRODUCTVERSION MACZOOM_VERSION_MAJOR, MACZOOM_VERSION_MINOR, MACZOOM_VERSION_PATCH, 0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Hel Industries"
            VALUE "FileDescription", "MacZoom"
            VALUE "FileVersion", MACZOOM_VERSION_STRING
            VALUE "InternalName", "MacZoom"
            VALUE "LegalCopyright", "Copyright (c) 2026 Paul Schulze (Hel Industries)"
            VALUE "OriginalFilename", "MacZoom.exe"
            VALUE "ProductName", "MacZoom"
            VALUE "ProductVersion", MACZOOM_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
